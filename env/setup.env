#!/usr/bin/env bash
# setup_env.sh
#
# Recria o ambiente a partir do backup gerado por backup_environment.sh,
# num servidor novo/recém-formatado. Faz tudo de uma vez:
#
#   1. extrai o SUMO em ~/sumo
#   2. garante SUMO_HOME/PYTHONPATH no ~/.bashrc (traci/sumolib SEMPRE
#      resolvidos a partir daí -- nunca via pip, pra evitar o mismatch de
#      versão que já vimos acontecer no LCAD2)
#   3. cria um venv e instala só as libs do requirements_project.txt
#   4. confere no final que traci/sumolib/sumo batem com o esperado
#
# Uso:
#   bash setup_env.sh /caminho/para/env_backup_<host>_<data>/

set -euo pipefail

BACKUP_DIR="${1:?Uso: bash setup_env.sh <pasta com sumo.tar.gz e requirements_project.txt>}"

if [ ! -f "$BACKUP_DIR/sumo.tar.gz" ]; then
    echo "ERRO: não achei $BACKUP_DIR/sumo.tar.gz"
    exit 1
fi

echo "== 0/4: dependências de SISTEMA do SUMO (apt) =="
if [ -f "$BACKUP_DIR/sumo_apt_packages.txt" ] && [ -s "$BACKUP_DIR/sumo_apt_packages.txt" ]; then
    echo "   instalando $(wc -l < "$BACKUP_DIR/sumo_apt_packages.txt") pacote(s) apt que o SUMO precisa..."
    sudo apt-get update -qq
    # shellcheck disable=SC2046
    sudo apt-get install -y $(cat "$BACKUP_DIR/sumo_apt_packages.txt") \
        || echo "   AVISO: algum pacote falhou -- confere o nome/versão manualmente, pode ser repositório diferente neste SO."
else
    echo "   AVISO: $BACKUP_DIR/sumo_apt_packages.txt não encontrado ou vazio -- pulei (o SUMO pode falhar por lib de sistema faltando)."
fi

echo
echo "== 1/4: restaurando SUMO em ~/sumo =="
if [ -d ~/sumo ]; then
    echo "   ~/sumo já existe -- renomeando pra ~/sumo_old_$(date +%Y%m%d%H%M%S) antes de extrair"
    mv ~/sumo ~/sumo_old_$(date +%Y%m%d%H%M%S)
fi
tar xzf "$BACKUP_DIR/sumo.tar.gz" -C ~
echo "   -> ~/sumo restaurado"

echo
echo "== 2/4: configurando SUMO_HOME/PYTHONPATH no ~/.bashrc =="
if ! grep -q "^export SUMO_HOME=" ~/.bashrc 2>/dev/null; then
    {
        echo ''
        echo '# SUMO (restaurado via setup_env.sh)'
        echo 'export SUMO_HOME="$HOME/sumo"'
        echo 'export PYTHONPATH="$SUMO_HOME/tools:$PYTHONPATH"'
    } >> ~/.bashrc
    echo "   -> adicionado ao ~/.bashrc"
else
    echo "   -> ~/.bashrc já tem SUMO_HOME, não mexi (confere manualmente se aponta pra ~/sumo)"
fi
export SUMO_HOME="$HOME/sumo"
export PYTHONPATH="$SUMO_HOME/tools:$PYTHONPATH"

echo
echo "== 3/4: criando venv e instalando dependências do projeto =="
python3 -m venv ~/venv_tcc
# shellcheck disable=SC1091
source ~/venv_tcc/bin/activate
pip install --upgrade pip --quiet
if [ -f "$BACKUP_DIR/requirements_project.txt" ]; then
    pip install -r "$BACKUP_DIR/requirements_project.txt"
else
    echo "   AVISO: requirements_project.txt não encontrado em $BACKUP_DIR -- pulei a instalação."
fi

echo
echo "== 4/4: verificação final (sumo, traci, sumolib, libsumo) =="
echo "--- libs de sistema faltando (deve vir vazio) ---"
MISSING=$(ldd "$SUMO_HOME/bin/sumo" 2>/dev/null | grep "not found" || true)
if [ -n "$MISSING" ]; then
    echo "   *** FALTANDO (sumo provavelmente vai falhar ao rodar) ***"
    echo "$MISSING"
    echo "   -> confere sumo_apt_packages.txt e reinstala manualmente o que faltou"
else
    echo "   OK -- nenhuma lib de sistema faltando"
fi
echo
echo "--- sumo (binário) ---"
"$SUMO_HOME/bin/sumo" --version | head -1
echo
python3 - <<'PYEOF'
print("--- traci (Python) ---")
try:
    import traci
    print("arquivo:", traci.__file__)
    print("traci.__version__:", getattr(traci, "__version__", "n/a -- essa versão não expõe isso"))
    try:
        import traci.constants as tc
        print("traci API version (TRACI_VERSION):", getattr(tc, "TRACI_VERSION", "n/a"))
    except Exception as e:
        print("traci.constants: erro ->", e)
except Exception as e:
    print("traci: NAO DISPONIVEL ->", e)

print()
print("--- sumolib (Python) ---")
try:
    import sumolib
    print("arquivo:", sumolib.__file__)
    print("sumolib.__version__:", getattr(sumolib, "__version__", "n/a -- essa versão não expõe isso"))
except Exception as e:
    print("sumolib: NAO DISPONIVEL ->", e)

print()
print("--- libsumo (Python, opcional) ---")
try:
    import libsumo
    print("arquivo:", libsumo.__file__)
    try:
        print("libsumo.getVersion():", libsumo.getVersion())
    except Exception as e:
        print("libsumo.getVersion(): erro ->", e)
except Exception as e:
    print("libsumo: NAO DISPONIVEL/NAO COMPILADO nesse build ->", type(e).__name__, str(e))
PYEOF
echo
echo "Compare esse bloco com o VERSIONS.txt do backup -- deve bater igual."

echo
echo "Pronto. A partir de agora, em qualquer sessão nova:"
echo "  source ~/venv_tcc/bin/activate"
echo "(SUMO_HOME e PYTHONPATH já ficam persistidos no ~/.bashrc, não precisa repetir)"
